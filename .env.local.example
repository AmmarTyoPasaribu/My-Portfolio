# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real keys.

# Get a free OpenRouter API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional — override the model used by the portfolio chat widget.
# Defaults to openai/gpt-oss-20b:free if unset. Browse free (":free" suffix)
# and paid models at https://openrouter.ai/models — the free ones share
# rate-limited capacity across all OpenRouter users (routed through whatever
# upstream provider is serving that model), so responses can occasionally be
# slow or 429 under load; that's an OpenRouter-side tradeoff, not a bug here.
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
